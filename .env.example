# Copy to .env and fill in. Never commit .env.
PORT=3000
# Long random string used to sign sessions and encrypt integration tokens at rest.
APP_SECRET=change-me-to-a-long-random-string
# Password for the seeded demo accounts (admin/pm/architect/dev/qa @demo.local).
DEMO_PASSWORD=Bootcamp@2026
SEED_DEMO_USERS=true
# Create the handbook sample project, fully approved through all four gates, on start (if missing).
SEED_DEMO_PROJECT=false
MAX_UPLOAD_MB=10

# Azure OpenAI (pre-configured for the bootcamp). Leave blank to use the offline engine.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-5-5
AZURE_OPENAI_API_VERSION=2024-10-21
# auto = Azure OpenAI when configured, otherwise offline engine; mock = always offline
AI_MODE=auto
# Critic score below which the orchestrator asks the feedback agent to self-revise once (AI mode)
CRITIC_SELF_REVISE_THRESHOLD=70

# Allow Jira Server/Data Center on private network hosts (SSRF guard is on by default)
ALLOW_PRIVATE_INTEGRATION_HOSTS=false
